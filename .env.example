APP_NAME="Battlefront Computer Trading"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Battlefront-only shipping simulation; local/testing only and disabled by default.
BATTLEFRONT_LBC_MOCK_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

BATTLEFRONT_GCASH_ACCOUNT_NAME="Battlefront Demo GCash Account"
BATTLEFRONT_GCASH_ACCOUNT_NUMBER="09XX XXX XXXX"
BATTLEFRONT_GCASH_IS_DEMO=true
BATTLEFRONT_MAYA_ACCOUNT_NAME="Battlefront Demo Maya Account"
BATTLEFRONT_MAYA_ACCOUNT_NUMBER="09XX XXX XXXX"
BATTLEFRONT_MAYA_IS_DEMO=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
CHATBOT_TIMEOUT_SECONDS=20

EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_CA_BUNDLE=

PAYMONGO_ENABLED=true
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_HOSTED_METHODS=card,gcash,paymaya,qrph
PAYMONGO_DIRECT_BANKING_ENABLED=false

# Algolia preparation: enable Scout only after installing and configuring the integration.
# Server-side credentials only; never prefix the secret with VITE_.
SCOUT_DRIVER=null
SCOUT_PREFIX=battlefront_local_
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

# QDRANT CLOUD - VECTOR DATABASE
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=battlefront_products
QDRANT_TIMEOUT_SECONDS=10

# NEO4J AURADB - GRAPH DATABASE
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# GEMINI MULTI-API CONFIGURATION (preparation only)
# API 1 - Scope and Intent Classification
GEMINI_SCOPE_API_KEY=
# API 2 - Product Knowledge and Responses
GEMINI_RESPONSE_API_KEY=
# API 3 - Response Validation
GEMINI_VALIDATION_API_KEY=
